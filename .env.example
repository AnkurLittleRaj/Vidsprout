# Copy to .env.local. Never commit real credentials.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MONGODB_URI=
MONGODB_DB=vidsprout

# Local Inngest CLI: pnpm dlx inngest-cli@latest dev
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Sandbox project access. No provider calls run until explicitly enabled.
# Remotion's Sandbox helper uses Vercel OIDC. For local use, link a project
# and pull an OIDC token using Vercel CLI. Tokens expire; do not commit them.
VERCEL_OIDC_TOKEN=
ENABLE_LIVE_RENDER=false
LOCAL_RENDER=false
LOCAL_PREVIEW=false

# Operator-only narration credentials; never NEXT_PUBLIC variables.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Build the trusted render-bundle directory with pnpm render:bundle first.

# Require real account sessions for local lesson creation and media access.
# Enable after MongoDB setup; missing/unavailable database fails closed.
LOCAL_ACCOUNT_AUTH=false

# Optional local Node DNS override; ignored in production and on Vercel.
LOCAL_DNS_SERVERS=
