{
  "name": "vidsprout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "setup:check": "node scripts/check-setup.mjs",
    "worker:local": "tsx --env-file=.env.local scripts/local-worker.ts",
    "render:preview": "node scripts/render-preview.mjs",
    "narrate:evaporation": "node scripts/narrate-evaporation.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
